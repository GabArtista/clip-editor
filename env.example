#
# Exemplo de configuração (.env) para o Clip Editor API
# Copie para `.env` e ajuste os valores reais.
#

# App
APP_NAME=Clip Editor API
APP_VERSION=2.0.0
APP_HOST=0.0.0.0
APP_PORT=8060
APP_WORKERS=2
DEBUG=false

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=clip_editor
DB_PASSWORD=clip_editor_pass
DB_NAME=clip_editor_db
# Opcional: sobrescreva se quiser uma URL completa
# DATABASE_URL=postgresql://clip_editor:clip_editor_pass@localhost:5432/clip_editor_db

# JWT
JWT_SECRET_KEY=altere-para-um-segredo-forte
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Paths locais
VIDEOS_DIR=videos
PROCESSED_DIR=processed
MUSIC_DIR=music
COOKIES_DIR=cookies
SESSION_FILE_PATH=cookies/session.netscape

# N8N
# Cada usuário define seu próprio webhook no cadastro. Opcional para debug:
# N8N_WEBHOOK_URL=https://example.com/webhook/uuid

# S3 / MinIO
S3_BUCKET_NAME=clip-dev
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=SEU_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=SEU_SECRET_KEY
# Para MinIO (recomendado)
AWS_ENDPOINT_URL=https://minio.dozecrew.com
AWS_S3_ADDRESSING_STYLE=path
# Alternativo (se quiser usar nomes S3_*)
S3_ENDPOINT_URL=https://minio.dozecrew.com
S3_FORCE_PATH_STYLE=true

# Vídeo (expiração/limpeza)
VIDEO_PREVIEW_EXPIRATION_MINUTES=5
VIDEO_DELETE_AFTER_PUBLICATION_HOURS=3
APP_HOST=127.0.0.1
APP_PORT=8000
APP_WORKERS=2
LOG_LEVEL=info
VIDEOS_DIR=videos
PROCESSED_DIR=processed
MUSIC_DIR=music

# AWS S3
S3_BUCKET_NAME=your-bucket-name
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
